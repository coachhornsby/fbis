# Copy to `.env` for local Wrangler/Pages Functions.
# Names only — never put real values in git, PRs, or chat.

# Upstream APIs (Cloudflare Pages secrets in production)
PARLAY_API_KEY=
THEODDS_API_KEY=
BALLPARK_PAL_API_KEY=
CFBD_API_KEY=
CBBD_API_KEY=

# Odds provider pool fallbacks (intentional production redundancy).
# Optional only for startup / safe degrade — when installed, they are active
# fallbacks: Parlay → TheOdds → SharpAPI → TheRundown → fail closed.
# Install newly rotated credentials only — never reuse historical compromised values.
SHARPAPI_API_KEY=
THERUNDOWN_API_KEY=

# Apify Action Network SHADOW research only (never production odds router).
# Install as a Cloudflare Pages secret. Never commit real values.
APIFY_TOKEN=

# Protects collect / harvest / strategy import endpoints
HARVEST_SECRET=
# Optional alias for strategy import only
STRATEGY_IMPORT_SECRET=

# Cloudflare tooling (local deploy / migrations; never commit)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
